global:
  scrape_interval: 30s
  evaluation_interval: 30s
scrape_configs:
- job_name: monitoring-server
  static_configs:
  - targets:
    - monitoring-node:9100
- job_name: prometheus
  static_configs:
  - targets:
    - localhost:9090
- job_name: loki
  static_configs:
  - targets:
    - loki:3100
- job_name: blackbox
  static_configs:
  - targets:
    - blackbox:9115
- job_name: uptime
  metrics_path: /probe
  params:
    module:
    - http_2xx
  static_configs:
  - targets:
    - '@PUBLIC_MONITOR_URL@/'
    - '@PUBLIC_MONITOR_URL@/actuator/health/readiness'
  relabel_configs:
  - source_labels:
    - __address__
    target_label: __param_target
  - source_labels:
    - __param_target
    target_label: instance
  - target_label: __address__
    replacement: blackbox:9115
