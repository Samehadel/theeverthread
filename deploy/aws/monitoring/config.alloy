logging {
  level = "warn"
}

local.file_match "containers" {
  path_targets = [{__path__ = "/host/docker/*/*-json.log", job = "containers"}]
}

loki.source.file "containers" {
  targets    = local.file_match.containers.targets
  forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
  stage.json {
    expressions = {
      service = "attrs.\"com.docker.compose.service\"",
      project = "attrs.\"com.docker.compose.project\"",
    }
  }
  stage.labels {
    values = {service = "", project = ""}
  }
  // Only application logs; collecting Loki/Alloy's own logs creates feedback loops.
  stage.match {
    selector = "{job=\"containers\",service!~\"backend|frontend\"}"
    action   = "drop"
  }
  stage.docker {}
  stage.match {
    selector = "{service=\"backend\"}"
    stage.multiline {
      firstline     = "^\\d{4}-\\d{2}-\\d{2}"
      max_wait_time = "3s"
      max_lines     = 128
    }
  }
  forward_to = [loki.write.local.receiver]
}

// Persistent and volatile journald locations cover Ubuntu host services,
// SSH, kernel events, and Docker daemon messages without the Docker API socket.
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "persistent" {
  path       = "/host/var/log/journal"
  labels     = {job = "host-journal", source = "persistent"}
  relabel_rules = loki.relabel.journal.rules
  forward_to = [loki.write.local.receiver]
}

loki.source.journal "runtime" {
  path       = "/host/run/log/journal"
  labels     = {job = "host-journal", source = "runtime"}
  relabel_rules = loki.relabel.journal.rules
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  external_labels = {host = "application"}
  endpoint {
    url = sys.env("MONITORING_INGEST_URL") + "/loki/api/v1/push"
    bearer_token_file = "/run/secrets/ingestion_token"
    tls_config {
      ca_file = "/run/secrets/monitoring_ca"
    }
  }
}


prometheus.scrape "backend" {
  targets = [{__address__ = "backend:8080", job = "backend"}]
  metrics_path = "/actuator/prometheus"
  scrape_interval = "30s"
  bearer_token_file = "/run/secrets/prometheus_token"
  forward_to = [prometheus.relabel.backend.receiver]
}

prometheus.relabel "backend" {
  rule {
    source_labels = ["uri"]
    regex = "/actuator/.*"
    action = "drop"
  }
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

prometheus.scrape "server" {
  targets = [{__address__ = "node-exporter:9100", job = "server"}]
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

prometheus.scrape "self" {
  targets = [{__address__ = "localhost:12345", job = "alloy"}]
  scrape_interval = "30s"
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

prometheus.remote_write "monitoring" {
  external_labels = {host = "application"}
  endpoint {
    url = sys.env("MONITORING_INGEST_URL") + "/api/v1/write"
    bearer_token_file = "/run/secrets/ingestion_token"
    tls_config {
      ca_file = "/run/secrets/monitoring_ca"
    }
    queue_config {
      max_shards = 4
    }
  }
}
