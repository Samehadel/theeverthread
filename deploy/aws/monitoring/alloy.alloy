// Collect only the two application services, even after Compose replaces them.
discovery.docker "application" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "30s"

	filter {
		name   = "label"
		values = ["com.docker.compose.project=theeverthread-prod"]
	}
}

discovery.relabel "application" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "backend|frontend"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service_name"
	}
}

loki.source.docker "application" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.application.targets
	relabel_rules = discovery.relabel.application.rules
	labels        = {job = "application-containers", host = "application"}
	forward_to    = [loki.process.application.receiver]
}

loki.process "application" {
	forward_to = [loki.write.monitoring.receiver]

	// Start with recent history on the small host, matching the journal window.
	stage.drop {
		older_than          = "1h"
		drop_counter_reason = "outside_collection_window"
	}

	stage.match {
		selector = "{service_name=\"backend\"}"

		stage.multiline {
			firstline     = "^([0-9]{4}-[0-9]{2}-[0-9]{2}[T ]|\\s*\\.\\s+____)"
			max_wait_time = "2s"
			max_lines     = 128
		}
	}
}

discovery.relabel "journal" {
	targets = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "host" {
	path          = "/var/log/journal"
	max_age       = "1h"
	labels        = {job = "host-journal", host = "application", service_name = "host-journal"}
	relabel_rules = discovery.relabel.journal.rules
	forward_to    = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
	max_streams = 1000

	endpoint {
		url                 = "https://172.31.41.48:3100/loki/api/v1/push"
		batch_size          = "128KiB"
		batch_wait          = "2s"
		remote_timeout      = "10s"
		min_backoff_period  = "1s"
		max_backoff_period  = "30s"
		max_backoff_retries = 20

		tls_config {
			ca_file     = "/run/secrets/alloy_ca"
			cert_file   = "/run/secrets/alloy_certificate"
			key_file    = "/run/secrets/alloy_key"
			min_version = "TLS12"
		}
	}
}
