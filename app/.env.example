# Copy to .env and set a local-only password before starting.
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432
DB_NAME=theeverthread
POSTGRES_VOLUME=theeverthread_postgres-data
DB_URL=jdbc:postgresql://127.0.0.1:5432/theeverthread
SERVER_PORT=8080
BACKEND_URL=http://127.0.0.1:8080

# Local HTTP development only. Production keeps secure cookies enabled.
SESSION_COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:4200
# Local Resend stub. Use separate credentials and a generated 32-byte key outside local development.
RESEND_API_URL=http://127.0.0.1:8025
RESEND_API_KEY=local-resend-stub
RESEND_WEBHOOK_SECRET=whsec_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
EMAIL_PAYLOAD_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MAIL_FROM=no-reply@theeverthread.local

# Default cap includes active administrators; pending invitations do not count.
INVITATION_MAX_ACTIVE_ACCOUNTS=10

# Absolute refresh lifetime; rotation does not extend it.
REFRESH_TOKEN_LIFETIME=14d

# Knowledge refinement and asynchronous classification (server only).
## Supply a server-only key to enable AI requests.
# OPENAI_API_KEY=replace-me

# Optional social login. Register PUBLIC_ORIGIN + /api/auth/oauth/callback/{provider}.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_API_VERSION=v23.0
